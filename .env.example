# Copy to .env and fill in. Never commit .env.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development          # development | production  (production enforces the checks in docs/DEPLOYMENT.md)
DEBUG=false
LOG_LEVEL=                       # empty = INFO (DEBUG when DEBUG=true)
DOCS_ENABLED=true                # set false to hide /docs and /openapi.json in production

# --- Security ----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=*                  # production example: api.example.com
API_RATE_LIMIT_PER_MINUTE=240    # per client IP, 0 = off
LLM_RATE_LIMIT_PER_MINUTE=30     # per client IP, interview generation/scoring
MAX_UPLOAD_MB=5

# --- Database (used by docker compose; URL-encode special characters in the password) ---
POSTGRES_USER=career
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=career_agent
# Without compose: DATABASE_URL=postgresql+psycopg://career:password@localhost:5432/career_agent

# --- AI (optional: everything has a rule-based fallback) ----------------------
LLM_MODEL=groq:llama-3.3-70b-versatile
GROQ_API_KEY=
OPENAI_API_KEY=                  # resume intelligence extraction needs this
INTERVIEW_USE_LLM=true

# --- Tracking ------------------------------------------------------------------
DEFAULT_FOLLOW_UP_DAYS=7
GHOSTED_AFTER_DAYS=30

# --- Container -----------------------------------------------------------------
WITH_EMBEDDINGS=true             # false = much smaller image, weaker RAG embeddings
WEB_CONCURRENCY=1                # >1 makes in-memory rate limits per-worker
RUN_MIGRATIONS=1                 # 0 when running several replicas (migrate as a release step)
FORWARDED_ALLOW_IPS=127.0.0.1    # set to your reverse proxy's IP/CIDR (or *) so client IPs are real
